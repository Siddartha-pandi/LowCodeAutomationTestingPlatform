# ==============================================================================
# LowCodeAutomationTestingPlatform - Monorepo Root Environment Template
# Architecture: Unified NestJS Backend + Playwright Engine + Next.js 16 Frontend
# Template: Production & Local Development Example
# Compliance: Strict Zero-AI Policy (100% Deterministic)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVICE PORTS
# ------------------------------------------------------------------------------
PORT=8000
FRONTEND_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
AUTOMATION_SERVICE_PORT=8000

# Node runtime environment (development | production | test)
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. FRONTEND PUBLIC ENDPOINTS & BRANDING
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_APP_NAME="AgentFlow Automation Platform"
NEXT_PUBLIC_COMPANY_NAME="Enterprise QA Systems"
NEXT_PUBLIC_SUPPORT_EMAIL="support@enterprise.local"

# Allowed CORS origins for browser web requests (comma-separated list)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Disable telemetry for faster cold startup
NEXT_TELEMETRY_DISABLED=1

# Hot Module Replacement (HMR) polling for Docker / DevContainers (disabled by default to prevent high CPU disk I/O)
WATCHPACK_POLLING=false

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=automation_platform_db
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/automation_platform_db
DB_SYNCHRONIZE=false
DATABASE_SSL=false

# ------------------------------------------------------------------------------
# 4. QUEUE & EVENT BROKER (Redis 7 & BullMQ)
# ------------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ------------------------------------------------------------------------------
# 5. SECURITY & ENCRYPTION
# ------------------------------------------------------------------------------
# Minimum 32-character secret for JWT signing:
JWT_SECRET=enterprise-production-jwt-secret-key-32chars
JWT_SECRET_KEY=enterprise-production-jwt-secret-key-32chars
TOKEN_EXPIRY_MINUTES=480

# Master encryption keys for AES-256-GCM Credential Vault (32 characters):
CREDENTIALS_MASTER_KEY=enterprise-master-encryption-key-32chars
APP_ENCRYPTION_KEY=enterprise-master-encryption-key-32chars

# Secret key for internal microservice-to-microservice authentication:
INTERNAL_SERVICE_KEY=enterprise-internal-secret-service-key-32chars

# ------------------------------------------------------------------------------
# 6. INITIAL SEED ADMIN CREDENTIALS
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123!Secure

# ------------------------------------------------------------------------------
# 7. STORAGE & SYSTEM PATHS
# ------------------------------------------------------------------------------
STORAGE_DIR=./storage
DEFAULT_TIMEZONE=Asia/Kolkata

# ------------------------------------------------------------------------------
# 8. PLAYWRIGHT AUTOMATION ENGINE & WORKER
# ------------------------------------------------------------------------------
# Embedded worker mode: automatically runs BullMQ browser execution worker inside the backend process
EMBED_WORKER=true
WORKER_CONCURRENCY=4
BROWSER_TIMEOUT_MS=30000
ALLOWED_DOMAINS=localhost,127.0.0.1,*.company.internal,*.company.local

# ------------------------------------------------------------------------------
# 9. MANDATORY COMPANY DATA PROTECTION GUARANTEE (ZERO-AI COMPLIANCE)
# ------------------------------------------------------------------------------
ZERO_AI_POLICY_ENFORCED=true
