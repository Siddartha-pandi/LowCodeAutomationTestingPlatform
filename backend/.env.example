# ==============================================================================
# LowCodeAutomationTestingPlatform - Unified Environment Configuration Template
# Architecture: Unified NestJS Backend + Playwright Engine + Next.js Frontend
# Compliance: Strict Zero-AI Policy (100% Deterministic)
# ==============================================================================

# 1. APPLICATION & BRANDING
NEXT_PUBLIC_APP_NAME="AgentFlow Automation Platform"
NEXT_PUBLIC_COMPANY_NAME="Enterprise QA Systems"
NEXT_PUBLIC_SUPPORT_EMAIL="support@enterprise.local"

# 2. SERVER NETWORK CONFIGURATION
PORT=8000
NODE_ENV=production
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# 3. DATABASE CONFIGURATION (PostgreSQL 16)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/automation_platform_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=automation_platform_db

# 4. QUEUE & EVENT BROKER (Redis 7 & BullMQ)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 5. SECURITY & ENCRYPTION
# Minimum 32-character secret for JWT signing:
JWT_SECRET=enterprise-production-jwt-secret-key-32chars
TOKEN_EXPIRY_MINUTES=480

# Master encryption key for AES-256-GCM Credential Vault:
CREDENTIALS_MASTER_KEY=enterprise-master-encryption-key-32chars
APP_ENCRYPTION_KEY=enterprise-master-encryption-key-32chars

# Secret key for internal service-to-service communication:
INTERNAL_SERVICE_KEY=enterprise-internal-secret-service-key-32chars

# 6. STORAGE & SYSTEM PATHS
STORAGE_DIR=./storage
DEFAULT_TIMEZONE=Asia/Kolkata

# 7. PLAYWRIGHT AUTOMATION ENGINE & WORKER
WORKER_CONCURRENCY=4
BROWSER_TIMEOUT_MS=30000
ALLOWED_DOMAINS=localhost,127.0.0.1,*.company.internal,*.company.local

# 8. MANDATORY COMPANY DATA PROTECTION GUARANTEE
ZERO_AI_POLICY_ENFORCED=true
