# ==============================================================================
# LowCodeAutomationTestingPlatform - Frontend Environment Configuration Template
# Framework: Next.js 16 (App Router) + React 19
# Compliance: Strict Zero-AI Policy (100% Deterministic)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER RUNTIME
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. BACKEND API & WEBSOCKET ENDPOINTS
# ------------------------------------------------------------------------------
# Publicly accessible HTTP REST URL for the unified NestJS backend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Publicly accessible WebSocket URL for real-time execution streaming
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ------------------------------------------------------------------------------
# 3. BRANDING & APPLICATION METADATA
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="AgentFlow Automation Platform"
NEXT_PUBLIC_COMPANY_NAME="Enterprise QA Systems"
NEXT_PUBLIC_SUPPORT_EMAIL="support@enterprise.local"
