{
  "name": "LowCode Automation Platform (Single Container)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "workspaceFolder": "/workspaces/LowCodeAutomationTestingPlatform",
  "remoteUser": "TeamDolphin",
  "runArgs": [
    "--init",
    "--shm-size=2gb",
    "--name",
    "dolphin-devcontainer-single"
  ],
  "containerEnv": {
    "NODE_ENV": "development",
    "PORT": "8000",
    "FRONTEND_PORT": "3000",
    "DATABASE_URL": "postgresql://postgres:postgres@127.0.0.1:5432/automation_platform_db",
    "DB_SYNCHRONIZE": "true",
    "REDIS_HOST": "127.0.0.1",
    "REDIS_PORT": "6379",
    "POSTGRES_HOST": "127.0.0.1",
    "POSTGRES_USER": "postgres",
    "POSTGRES_PASSWORD": "postgres",
    "POSTGRES_DB": "automation_platform_db",
    "JWT_SECRET": "4be9367e7fb1cbfe36da95e281190c8367b38c48f7a5128e3bd015be867325ba",
    "JWT_SECRET_KEY": "4be9367e7fb1cbfe36da95e281190c8367b38c48f7a5128e3bd015be867325ba",
    "CREDENTIALS_MASTER_KEY": "47d0efd64879b9733be0317b85d2d490060ec45315ff45df38e8c3d39d855b23",
    "APP_ENCRYPTION_KEY": "47d0efd64879b9733be0317b85d2d490060ec45315ff45df38e8c3d39d855b23",
    "INTERNAL_SERVICE_KEY": "86d5b47c05751d8bf5194f23f310e0da87400c15a8afd57ab15e1216e2327d17",
    "ADMIN_EMAIL": "admin@example.com",
    "ADMIN_PASSWORD": "Admin123!Secure",
    "STORAGE_DIR": "/workspaces/LowCodeAutomationTestingPlatform/storage",
    "DEFAULT_TIMEZONE": "Asia/Kolkata",
    "CORS_ORIGIN": "http://localhost:3000,http://127.0.0.1:3000",
    "NEXT_PUBLIC_API_URL": "http://localhost:8000",
    "NEXT_PUBLIC_WS_URL": "ws://localhost:8000",
    "WATCHPACK_POLLING": "false"
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh",

  "forwardPorts": [3000, 8000, 5432, 6379],
  "portsAttributes": {
    "3000": {
      "label": "Next.js Frontend",
      "onAutoForward": "openBrowserOnce"
    },
    "8000": {
      "label": "Unified NestJS API",
      "onAutoForward": "silent"
    },
    "5432": {
      "label": "PostgreSQL Database (Internal)",
      "onAutoForward": "silent"
    },
    "6379": {
      "label": "Redis BullMQ Queue (Internal)",
      "onAutoForward": "silent"
    }
  },

  "customizations": {
    "vscode": {
      "settings": {
        "task.allowAutomaticTasks": "on",
        "terminal.integrated.defaultProfile.linux": "bash",
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "typescript.tsdk": "backend/node_modules/typescript/lib",
        "playwright.reuseBrowser": true
      },
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-playwright.playwright",
        "firsttris.vscode-jest-runner",
        "Orta.vscode-jest",
        "ckolkman.vscode-postgres",
        "redhat.vscode-yaml",
        "tamasfe.even-better-toml",
        "mikestead.dotenv"
      ]
    }
  }
}
